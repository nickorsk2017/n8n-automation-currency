# freecurrencyapi.com API key — used by Workflow 1 (Daily Currency Rate Loader)
# to call the /latest endpoint. Get a free-tier key at https://freecurrencyapi.com
FREECURRENCYAPI_KEY=your_freecurrencyapi_key_here

# LLM provider API key — used by Workflow 2 (AI Chat Agent) for the conversation
# model. Provider is configurable (OpenAI, Anthropic, etc.); name this for
# whichever provider is actually wired into the workflow's credential/HTTP node.
LLM_OPENAI_KEY=your_llm_provider_key_here
