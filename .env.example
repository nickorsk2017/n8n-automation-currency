# freecurrencyapi.com API key — provisioned into the Docker n8n instance's
# credential store by `make import-credentials` (scripts/import_credentials.sh),
# no manual n8n UI step needed. Get a free-tier key at https://freecurrencyapi.com
FREECURRENCYAPI_KEY=your_freecurrencyapi_key_here

# OpenAI API key used by Workflow 2 (AI Chat Currency Agent)'s chat model,
# provisioned the same way as FREECURRENCYAPI_KEY above. Required on the
# Docker stand: unlike n8n Cloud, a bare self-hosted instance has no managed
# free-credits OpenAI credential to fall back on.
LLM_OPENAI_KEY=your_llm_provider_key_here

# N8N_API_URL is the base URL of the running instance (host, not container-internal).
N8N_API_URL=http://localhost:5678
# Create a key in the running instance: Settings -> API -> Create API key.
N8N_API_KEY=your_n8n_api_key_here
